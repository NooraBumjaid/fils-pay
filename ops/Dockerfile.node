FROM node:22-bookworm-slim

WORKDIR /app

# argon2 is a native dependency and needs a compiler toolchain when npm
# cannot use a prebuilt binary for the target platform.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY db ./db
COPY scripts ./scripts

RUN npm ci

RUN mkdir -p /app/data/kyc && chown -R node:node /app
USER node

EXPOSE 3000
CMD ["npx", "tsx", "apps/api/src/index.ts"]
