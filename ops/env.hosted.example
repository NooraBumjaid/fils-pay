# Copy to ops/.env.hosted and fill in. Never commit the filled file.
# Generate:
#   POSTGRES_PASSWORD: url-safe random string
#   SETTLEMENT_INTERNAL_TOKEN: random string shared by API and settlement
#   WEBHOOK_SECRET_ENCRYPTION_KEY: `openssl rand -base64 32`
#   ACQUIRER_CALLBACK_SIGNING_SECRET: sandbox/demo acquirer HMAC secret

POSTGRES_PASSWORD=
SETTLEMENT_INTERNAL_TOKEN=
WEBHOOK_SECRET_ENCRYPTION_KEY=
ACQUIRER_CALLBACK_SIGNING_SECRET=

# HTTP demo boxes must keep this false or merchant/admin cookies will not stick.
COOKIE_SECURE=false

# Same-origin nginx hosting (recommended): the public HTTP origin only.
# If the SPAs still run on Vite 5173/5174, list those origins instead.
CORS_ORIGINS=http://YOUR_PUBLIC_HOST

# Origin used when minting payment-link URLs. Must match the public
# dashboard/checkout origin (no path). Do not guess a domain.
CHECKOUT_BASE_URL=http://YOUR_PUBLIC_HOST
